{% extends 'base.html.twig' %}

{% block title %}Item index{% endblock %}

{% block body %}
    <h1>Item index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Material</th>
                <th>Colour</th>
                <th>Damaged</th>
                <th>TypeOfClothing</th>
                <th>Price</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.id }}</td>
                <td>{{ item.Material }}</td>
                <td>{{ item.Colour }}</td>
                <td>{{ item.Damaged ? 'Yes' : 'No' }}</td>
                <td>{{ item.typeOfClothing }}</td>
                <td>{{ item.price }}</td>
                <td>
                    <a class = "btn btn-primary"  href="{{ path('app_item_show', {'id': item.id}) }}">show</a>
                    <a class = "btn btn-primary"  href="{{ path('app_item_edit', {'id': item.id}) }}">edit</a>
                    <a class = "btn btn-primary"  href="{{ path('app_item_buy', {'id': item.id}) }}">Buy</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_item_new') }}">Create new</a>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Rent an Item{% endblock %}

{% block body %}
    <h1>Rent an Item</h1>
    <form action="{{ path('app_clothing_item_rent') }}" method="post">
        <label for="item_name">Item Name:</label>
        <select id="item_name" name="item_name" required>
            {% for item, durations in items %}
                <optgroup label="{{ item }}">
                    {% for duration, price in durations %}
                        <option value="{{ item }}-{{ duration }}">{{ item }} - {{ duration }} - ${{ price }}</option>
                    {% endfor %}
                </optgroup>
            {% endfor %}
        </select><br><br>
        <button class = "btn btn-primary" type="submit">Rent</button>
    </form>
{% endblock %}

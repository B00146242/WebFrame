{% extends 'base.html.twig' %}

{% block title %}Hello ViewAvailableClothesController!{% endblock %}
{% block body %}
    <style>
        .names-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
            background: #F5F5F5;
            padding: 2px 6px;
        }
        .names-wrapper h1 {
            text-align: center;
        }
    </style>

    <div class="names-wrapper">
        <h1>List Of Available Clothes</h1>
        <ul>
            {% set names = [
                'Jacket', 'Jeans', 'Shirt', 'Joggers'
            ] %}
            {% for name in names %}
                <li>{{ name }}</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

